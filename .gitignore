# Downloaded third-party code and tools (TablePress, PHPUnit, Composer, PHPCS).
/.cache/
# Files written by tests at runtime.
/dev/fixtures/data/*
!/dev/fixtures/data/.gitkeep
.phpunit.result.cache

# Release builds (dev/build-zip.sh).
/dist/

# Browser checks (dev/release-checks/browser): dependencies, Chrome profile, outputs.
/dev/release-checks/browser/node_modules/
/dev/release-checks/browser/profile-rc/
/dev/release-checks/browser/profile-shots/
/dev/release-checks/browser/rc/
/dev/release-checks/browser/*.zip
/dev/release-checks/browser/*.png
